# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.
# See README.md for where to obtain each of these values.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of this deployment (used in emails, redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default business timezone for displaying dates/times (IANA name).
APP_TIMEZONE="Asia/Kolkata"

# ---------------------------------------------------------------------------
# Supabase (Database, Auth, Storage)
# Project Settings -> API in your Supabase project dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Service-role key: server-only, never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Direct Postgres connection string, used by migrations and by transactional
# domain operations (Student ID assignment, payment confirmation, receipt
# numbering) that need explicit row locking. Project Settings -> Database.
SUPABASE_DB_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# Razorpay (Payments)
# Dashboard -> Settings -> API Keys (key id/secret) and
# Dashboard -> Settings -> Webhooks (webhook secret).
# Use test-mode keys for local/dev/staging; live keys only in production.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ---------------------------------------------------------------------------
# Transactional Email
# Set EMAIL_PROVIDER to "resend" (default/recommended) or "sendgrid".
# Only the API key for the selected provider is required.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="resend"
RESEND_API_KEY="your-resend-api-key"
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM_ADDRESS="no-reply@example.com"
EMAIL_FROM_NAME="Roicians Tech"

# ---------------------------------------------------------------------------
# Rate Limiting (optional but recommended in production)
# Upstash Redis REST credentials, used to rate-limit auth, payment-initiation,
# the public lead form, and certificate verification endpoints.
# Leave blank in local development to fall back to an in-memory limiter.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
